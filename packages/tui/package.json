{
	"name": "@greppleai/grip-tui",
	"version": "0.1.5",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"files": [
		"dist/**/*",
		"native/win32/prebuilds/**/*.node",
		"native/darwin/prebuilds/**/*.node",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/greppleai/grip",
		"directory": "packages/tui"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.7.0",
		"marked": "18.1.1"
	},
	"devDependencies": {
		"@xterm/headless": "6.0.0",
		"@xterm/xterm": "6.0.0",
		"chalk": "6.0.1"
	}
}
