{
	"name": "@greppleai/grip-agent-core",
	"version": "0.1.6",
	"description": "General-purpose agent with transport abstraction, state management, and attachment support",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"test:harness": "vitest --run --config vitest.harness.config.ts",
		"coverage:harness": "vitest --run --config vitest.harness.config.ts --coverage",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@greppleai/grip-ai": "^0.1.6",
		"ignore": "7.0.13",
		"typebox": "1.4.3",
		"yaml": "2.9.1"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"transport",
		"state-management"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/greppleai/grip",
		"directory": "packages/agent"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "5.0.5",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
