{
  "name": "@greppleai/planner",
  "version": "1.0.0",
  "type": "module",
  "description": "File-backed planning and iterative build loops for Grip",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/greppleai/grip.git", "directory": "extensions/planner" },
  "keywords": ["grip-package"],
  "files": ["extensions/*.ts", "!extensions/*.test.ts", "skills", "README.md", "LICENSE", "NOTICE"],
  "grip": { "extensions": ["./extensions/index.ts"], "skills": ["./skills"] },
  "scripts": {
    "test": "bun test extensions",
    "typecheck": "tsc --noEmit",
    "build": "bun build extensions/index.ts --target node --packages external --outdir dist"
  },
  "dependencies": { "yaml": "2.9.0" },
  "peerDependencies": {
    "@greppleai/grip": ">=0.1.5",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}