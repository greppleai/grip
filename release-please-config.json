{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "node",
	"initial-version": "0.0.1",
	"bump-minor-pre-major": true,
	"bump-patch-for-minor-pre-major": true,
	"separate-pull-requests": false,
	"plugins": [
		{ "type": "node-workspace" },
		{
			"type": "linked-versions",
			"groupName": "grip",
			"components": ["@greppleai/grip-ai", "@greppleai/grip-agent-core", "@greppleai/grip-tui", "@greppleai/grip"]
		}
	],
	"packages": {
		"packages/ai": { "component": "@greppleai/grip-ai", "package-name": "@greppleai/grip-ai", "release-type": "node", "initial-version": "0.0.1", "changelog-path": "CHANGELOG.md" },
		"packages/agent": { "component": "@greppleai/grip-agent-core", "package-name": "@greppleai/grip-agent-core", "release-type": "node", "initial-version": "0.0.1", "changelog-path": "CHANGELOG.md" },
		"packages/tui": { "component": "@greppleai/grip-tui", "package-name": "@greppleai/grip-tui", "release-type": "node", "initial-version": "0.0.1", "changelog-path": "CHANGELOG.md" },
		"packages/coding-agent": { "component": "@greppleai/grip", "package-name": "@greppleai/grip", "release-type": "node", "initial-version": "0.0.1", "changelog-path": "CHANGELOG.md" }
	}
}
