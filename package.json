{
	"name": "grip-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/sandbox"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "cd packages/tui && npm run build && cd ../ai && npm run build && cd ../agent && npm run build && cd ../coding-agent && npm run build",
		"biome:check": "biome check",
		"biome:check:fix": "biome check --fix",
		"biome:format:fix": "biome format --fix",
		"biome:migrate": "biome migrate",
		"check": "biome check --write --error-on-warnings . && npm run check:near-identical-data-structures && npm run check:implementation-derived-type-aliases && npm run check:inline-type-imports && npm run check:inline-string-literal-unions && npm run check:excessive-collection-iterations && npm run check:versions && npm run check:pinned-deps && npm run check:ts-imports && npm run check:shrinkwrap && npm run check:install-lock:coding-agent && tsgo --noEmit && npm run check:browser-smoke",
		"check:near-identical-data-structures": "node .grip/biome/noNearIdenticalDataStructures.mjs",
		"check:implementation-derived-type-aliases": "node .grip/biome/noImplementationDerivedTypeAliases.mjs",
		"check:inline-type-imports": "node .grip/biome/noInlineTypeImports.mjs",
		"check:inline-string-literal-unions": "node .grip/biome/noInlineStringLiteralUnions.mjs",
		"check:excessive-collection-iterations": "node .grip/biome/noExcessiveCollectionIterations.mjs",
		"check:browser-smoke": "node scripts/check-browser-smoke.mjs",
		"check:versions": "node scripts/sync-versions.js",
		"check:pinned-deps": "node scripts/check-pinned-deps.mjs",
		"check:shrinkwrap": "node scripts/generate-coding-agent-shrinkwrap.mjs --check",
		"check:install-lock:coding-agent": "node scripts/generate-coding-agent-install-lock.mjs --check",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
		"profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
		"test": "npm run test:grip-config && npm run test --workspaces --if-present",
		"test:grip-config": "node --test .grip/biome/*.test.mjs .grip/hooks/*.test.mjs",
		"version:patch": "node scripts/sync-versions.js --bump patch && npm install --package-lock-only --ignore-scripts",
		"version:minor": "node scripts/sync-versions.js --bump minor && npm install --package-lock-only --ignore-scripts",
		"version:major": "node scripts/sync-versions.js --bump major && npm install --package-lock-only --ignore-scripts",
		"version:set": "node scripts/sync-versions.js --set",
		"prepublishOnly": "npm run clean && npm run build && npm run check",
		"publish": "npm run prepublishOnly && npm publish -ws --access public",
		"publish:dry": "npm run prepublishOnly && npm publish -ws --access public --dry-run",
		"release:local": "node scripts/local-release.mjs",
		"shrinkwrap:coding-agent": "node scripts/generate-coding-agent-shrinkwrap.mjs",
		"install-lock:coding-agent": "node scripts/generate-coding-agent-install-lock.mjs",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"prepare": "husky"
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.50",
		"@biomejs/biome": "2.6.2",
		"@hono/node-server": "2.1.5",
		"@types/node": "24.19.2",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"esbuild": "0.28.2",
		"hono": "4.13.13",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"shx": "0.3.4",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"typescript-ast": "npm:typescript@5.9.3"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"version": "0.1.10",
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
